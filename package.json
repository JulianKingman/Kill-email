{
  "name": "kill-email",
  "version": "2.0.0",
  "private": true,
  "description": "Terminate your inbox with extreme prejudice - 80s terminal-style email management powered by AI",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w @kill-email/server",
    "dev:client": "npm run dev -w @kill-email/client",
    "build": "npm run build -w @kill-email/shared && npm run build -w @kill-email/server && npm run build -w @kill-email/client",
    "build:server": "npm run build -w @kill-email/server",
    "build:client": "npm run build -w @kill-email/client",
    "start": "npm run start -w @kill-email/server",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules"
  },
  "keywords": [
    "email",
    "gmail",
    "ai",
    "terminal",
    "retro",
    "cli",
    "llm",
    "organization",
    "crt"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
