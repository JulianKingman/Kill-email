{
  "name": "kill-all-email",
  "version": "1.0.0",
  "description": "Terminate your inbox with extreme prejudice - 80s terminal-style email management powered by AI",
  "main": "dist/index.js",
  "bin": {
    "kill-email": "./dist/index.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist build-test",
    "test": "tsc -p tsconfig.test.json && node --test \"build-test/test/*.test.js\"",
    "web:dev": "concurrently \"npm run dev -w @kill-email/server\" \"npm run dev -w @kill-email/client\"",
    "web:build": "npm run build -w @kill-email/shared && npm run build -w @kill-email/server && npm run build -w @kill-email/client",
    "web:start": "npm run start -w @kill-email/server",
    "web:clean": "rm -rf packages/*/dist packages/*/node_modules"
  },
  "keywords": [
    "email",
    "gmail",
    "ai",
    "terminal",
    "retro",
    "cli",
    "llm",
    "organization"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "conf": "^10.2.0",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "imap": "^0.8.19",
    "inquirer": "^8.2.6",
    "mailparser": "^3.7.1",
    "marked": "^12.0.0",
    "nanoid": "^3.3.7",
    "ora": "^5.4.1",
    "terminal-kit": "^3.1.1"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/cli-progress": "^3.11.5",
    "@types/figlet": "^1.5.8",
    "@types/gradient-string": "^1.1.5",
    "@types/imap": "^0.8.40",
    "@types/inquirer": "^9.0.7",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
